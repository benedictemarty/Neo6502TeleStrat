diff -ru a/main.c b/main.c
--- a/main.c	2026-10-01 18:21:27.796315103 +0200
+++ b/main.c	2026-10-01 18:22:02.976094998 +0200
@@ -1826,6 +1826,39 @@
 
       if(ctx->framedone)
       {
+        {
+          /* Outil de comparaison (Neo6502TeleStrat) : écran texte après N trames */
+          static long dump_at = -2;
+          if(dump_at == -2) { const char* e = getenv("ORIC_DUMP_FRAMES"); dump_at = e ? atol(e) : -1; if(e) warpspeed = SDL_TRUE; }
+          if(dump_at >= 0 && (long)oric->frames >= dump_at)
+          {
+            int y, x;
+            for(y = 0; y < 28; y++)
+            {
+              for(x = 0; x < 40; x++)
+              {
+                unsigned char c = oric->mem[0xbb80 + y*40 + x] & 0x7f;
+                putchar((c >= 32 && c < 127) ? c : ' ');
+              }
+              putchar('\n');
+            }
+            fflush(stdout);
+            {
+              /* Image rendue (240 x 224, palette d'Oricutron) en PPM si ORIC_DUMP_PPM */
+              extern Uint8 oricpalette[];
+              const char* ppm = getenv("ORIC_DUMP_PPM");
+              FILE* f = ppm ? fopen(ppm, "wb") : NULL;
+              if(f && oric->scr)
+              {
+                int i;
+                fprintf(f, "P6\n240 224\n255\n");
+                for(i = 0; i < 240*224; i++) fwrite(&oricpalette[(oric->scr[i] & 7) * 3], 1, 3, f);
+              }
+              if(f) fclose(f);
+            }
+            exit(0);
+          }
+        }
         once_per_frame(oric);
 
         ctx->then = ctx->now;
